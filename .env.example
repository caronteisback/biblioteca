# Copy to .env before the first start. .env is git-ignored; never commit it.
# Format: KEY=VALUE, no quotes, no inline comments.
# No database port is published, so the example values are safe for a demo on your own machine.
# Change them for anything else.

# SYS/SYSTEM administrator password (used by the database container only).
ORACLE_PASSWORD=change_me_admin

# Application schema (created automatically on the first start).
APP_USER=biblioteca
APP_USER_PASSWORD=change_me_app

# Key that signs the sign-in tokens: at least 32 characters. The API does not start without it.
# The example value is fine for a demo on your own machine (nothing but the panel is reachable, and only from
# this computer). Anything else needs a random value of your own:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_random_value_of_at_least_32_characters

# Password of the three demo accounts (at least 12 characters): the librarian bibliotecaria@example.org and the
# members rosa.valdivia@example.org and mateo.quispe@example.org. Only the demo profile creates them.
DEMO_PASSWORD=change_me_demo_password

# Address of the panel: http://localhost:8081 (loopback only).
WEB_PORT=8081

# Optional. Build the API and the panel from local folders instead of the tagged releases:
# API_SOURCE=../biblioteca-java
# WEB_SOURCE=../biblioteca-web

# Optional. Another Oracle image, for example when Docker Hub limits anonymous pulls:
# ORACLE_IMAGE=ghcr.io/gvenzl/oracle-xe:21-slim-faststart
